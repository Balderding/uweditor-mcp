<Project Sdk="Microsoft.NET.Sdk">
  <!-- The editor without any UI or GL: opening games, levels, geometry, picking. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>UwEditor.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UwEditor.Core.Tests" />
    <InternalsVisibleTo Include="Robustness.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Underworld.Formats/Underworld.Formats.csproj" />
    <ProjectReference Include="../Underworld.Mods/Underworld.Mods.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- the randomizer's hand-written UW1 facts, every docs/facts/uw1-*.json (Randomizer/Facts.cs FactSet.Shipped) -->
    <EmbeddedResource Include="../../docs/facts/uw1-*.json" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../docs/facts/uw2-*.json" LogicalName="%(Filename)%(Extension)" />
    <!-- the conversations' names, docs/conversations/names-uw1.json and names-uw2.json (Conversations/ConversationNames.cs NameBook.LoadShipped) -->
    <EmbeddedResource Include="../../docs/conversations/names-*.json" LogicalName="%(Filename)%(Extension)" />
    <!-- the play test's default player of each game, a PLAYER.DAT only (DefaultPlayer.cs); never levels or other game data -->
    <EmbeddedResource Include="Resources/default-player-*.dat" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
